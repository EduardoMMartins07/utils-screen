<Window x:Class="ScreenControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controle rápido" Width="480" Height="410"
        MinWidth="440" MinHeight="380" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI" Foreground="{DynamicResource PrimaryText}">
    <Window.Resources>
        <Style x:Key="TrackRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="9" CornerRadius="5" Background="{DynamicResource TrackRemainder}"
                                VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilledTrackRepeatButton" TargetType="RepeatButton" BasedOn="{StaticResource TrackRepeatButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="9" CornerRadius="5" Background="{DynamicResource TrackFill}"
                                VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ThumbFill}" BorderBrush="{DynamicResource TrackFill}"
                                BorderThickness="3" CornerRadius="12" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="34" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" Height="34">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FilledTrackRepeatButton}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackRepeatButton}"
                                                  Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource ThemeSelectedBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CONTROLES DO NOTEBOOK" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryText}" />
                <TextBlock Text="Ajuste rápido" FontSize="25" FontWeight="SemiBold" Margin="0,3,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource ThemeControlBackground}" CornerRadius="10"
                    Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DarkThemeOption" Content="Escuro" GroupName="Theme" Style="{StaticResource ThemeChoice}"
                                 Checked="ThemeOption_OnChecked" />
                    <RadioButton x:Name="LightThemeOption" Content="Claro" GroupName="Theme" Style="{StaticResource ThemeChoice}"
                                 Checked="ThemeOption_OnChecked" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="14" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Background="{DynamicResource VolumeIconBackground}" CornerRadius="12" VerticalAlignment="Top">
                    <TextBlock Text="♫" FontSize="21" Foreground="{DynamicResource VolumeIconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock Text="Volume" FontSize="14" FontWeight="SemiBold" />
                    <Slider x:Name="VolumeSlider" Margin="0,12,0,2" ValueChanged="VolumeSlider_OnValueChanged" />
                    <TextBlock x:Name="VolumeStatus" Text="Saída de áudio padrão" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="VolumeValue" Grid.Column="2" Text="—%" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="14" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Background="{DynamicResource BrightnessIconBackground}" CornerRadius="12" VerticalAlignment="Top">
                    <TextBlock Text="☼" FontSize="25" Foreground="{DynamicResource BrightnessIconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock Text="Brilho da tela" FontSize="14" FontWeight="SemiBold" />
                    <Slider x:Name="BrightnessSlider" Margin="0,12,0,2" ValueChanged="BrightnessSlider_OnValueChanged" />
                    <TextBlock x:Name="BrightnessStatus" Text="Tela integrada" FontSize="11" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="BrightnessValue" Grid.Column="2" Text="—%" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="As alterações são aplicadas automaticamente." FontSize="11"
                   Foreground="{DynamicResource SecondaryText}" Margin="2,16,0,0" />
    </Grid>
</Window>
